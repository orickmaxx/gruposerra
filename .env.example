# Indexacao. Enquanto vazia, o site sai com noindex e o robots.txt bloqueia
# tudo. So ligue (=1) quando estiver no dominio definitivo do cliente: a
# homologacao publica e indexavel canibaliza a busca do site real.
NEXT_PUBLIC_INDEXAVEL=

# Medicao. Enquanto vazio, NADA e carregado e o site nao mede nada.
# Todos entram apenas DEPOIS do aceite no banner de cookies (Consent Mode v2).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Para onde vai o lead do formulario. n8n, Make, CRM, o que o cliente usar.
#
# 🔴 OBRIGATORIA EM PRODUCAO. Sem ela a acao cai para o arquivo
# `.leads/leads.jsonl`, e na Vercel o sistema de arquivos e somente leitura:
# a gravacao falha, o formulario devolve erro e manda a pessoa para o WhatsApp.
# Ninguem perde o contato em silencio (essa e a regra de `app/acoes.ts`), mas o
# formulario deixa de funcionar como formulario.
#
# Como conferir se esta valendo, com o site rodando:
#   1. preencha o formulario da home e envie;
#   2. a tela de sucesso aparece;
#   3. confira a chegada no destino (execucao no n8n, linha no CRM).
# Em desenvolvimento, sem a variavel, o lead cai em `.leads/leads.jsonl`, que
# esta no .gitignore por conter dado pessoal de gente de verdade.
#
# O corpo enviado e JSON:
#   { nome, whatsapp, cidade, assunto, mensagem, em (ISO), origem }
# `whatsapp` vai so com digitos, com DDD, sem mascara.
#
# ⚠️ O ENDPOINT PRECISA DEVOLVER 2xx. Qualquer outra coisa conta como falha e a
# acao cai para o arquivo. Nao aponte para uma URL que responde 302.
LEAD_WEBHOOK_URL=
